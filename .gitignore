🚀 SIMPLE UPGRADE (Do This Next)
🧱 Step 1: Show Bookings in Book.jsx
Below your form, add:
import { useEffect } from "react";import { collection, getDocs } from "firebase/firestore";import { db } from "../firebase/config";const [appointments, setAppointments] = useState([]);useEffect(() => {  const fetchData = async () => {    const querySnapshot = await getDocs(collection(db, "appointments"));    const data = querySnapshot.docs.map(doc => doc.data());    setAppointments(data);  };  fetchData();}, []);

🧱 Step 2: Display Them
Below your form:
<h3>Your Bookings</h3>{appointments.map((item, index) => (  <div key={index} style={{ border: "1px solid #ccc", margin: "10px", padding: "10px" }}>    <p>{item.name}</p>    <p>{item.date} - {item.time}</p>    <p>Status: {item.status}</p>  </div>))}

